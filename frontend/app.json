{
  "expo": {
    "name": "Lifepoints",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./public/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1729"
    },
    "ios": {
      "bundleIdentifier": "com.lifepoints.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "LP"
      }
    },
    "android": {
      "package": "com.lifepoints.app",
      "adaptiveIcon": {
        "foregroundImage": "./public/assets/adaptive-icon.png",
        "backgroundImage": "./public/assets/adaptive-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./public/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b55bd8e-2a9c-4580-858a-576e5fbafdbe"
      }
    },
    "owner": "tomhtzx"
  }
}
